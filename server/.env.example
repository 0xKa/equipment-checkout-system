# app
APP_ENV=development
HTTP_HOST=localhost
HTTP_PORT=8080

# api reference
API_DOCS_ENABLED=true

# postgres
DATABASE_URL=postgres://equipment_checkout:equipment_checkout@localhost:5433/equipment_checkout?sslmode=disable
POSTGRES_DB=equipment_checkout
POSTGRES_USER=equipment_checkout
# Compose embeds this development password in a connection URL; keep it URL-safe.
POSTGRES_PASSWORD=equipment_checkout
POSTGRES_PORT=5433
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTION_LIFETIME=30m

# OIDC resource server. These HTTP localhost values are development-only;
# production requires one stable HTTPS issuer and a separately reviewed
# network path to its JWKS endpoint.
OIDC_ISSUER_URL=http://localhost:8081/realms/equipment
OIDC_JWKS_URL=http://localhost:8081/realms/equipment/protocol/openid-connect/certs
OIDC_AUDIENCE=equipment-api
OIDC_HTTP_TIMEOUT=5s
OIDC_CLOCK_SKEW=30s

# Keycloak Admin API used only for application-owned user management.
KEYCLOAK_ADMIN_URL=http://localhost:8081
KEYCLOAK_REALM=equipment
KEYCLOAK_USER_SYNC_CLIENT_ID=equipment-user-sync
KEYCLOAK_ADMIN_TIMEOUT=5s

# Keycloak development runtime. Compose uses start-dev, publishes only the
# public/admin development endpoint on loopback, and keeps management port 9000
# internal. None of these values are a production deployment design.
KEYCLOAK_HTTP_PORT=8081
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_VOLUME_NAME=equipment-checkout-system_keycloak_postgres_data
# Development-only examples. Replace every password in server/.env.
KEYCLOAK_POSTGRES_PASSWORD=keycloak
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=admin
KEYCLOAK_EQUIPMENT_ADMIN_PASSWORD=equipment.admin
KEYCLOAK_SAMPLE_BORROWER_PASSWORD=sample.borrower
KEYCLOAK_AUDIT_VIEWER_PASSWORD=audit.viewer
# Must match the ignored local realm/service-account bootstrap value.
KEYCLOAK_USER_SYNC_CLIENT_SECRET=change-me-user-sync-secret
