{
  "id": "equipment",
  "realm": "equipment",
  "displayName": "Equipment Checkout System",
  "loginTheme": "equipment",
  "enabled": true,
  "sslRequired": "external",
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [],
    "client": {
      "equipment-api": [
        {
          "name": "employee",
          "description": "Borrow and return equipment within employee policy.",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "inventory_admin",
          "description": "Administer inventory and act on behalf of borrowers.",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "auditor",
          "description": "Read inventory and audit information without mutating it.",
          "composite": false,
          "clientRole": true
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "equipment-api",
      "name": "Equipment API",
      "description": "OAuth 2.0 resource server for the equipment checkout API.",
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [],
      "webOrigins": [],
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "publicClient": true,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false"
      },
      "fullScopeAllowed": false,
      "protocolMappers": [],
      "defaultClientScopes": [],
      "optionalClientScopes": []
    },
    {
      "clientId": "equipment-postman",
      "name": "Equipment Postman",
      "description": "Public development client for Authorization Code with PKCE.",
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": ["https://oauth.pstmn.io/v1/browser-callback"],
      "webOrigins": [],
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "publicClient": true,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false",
        "pkce.code.challenge.method": "S256"
      },
      "fullScopeAllowed": false,
      "protocolMappers": [],
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email",
        "equipment-api-access"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "equipment-user-sync",
      "name": "Equipment User Sync",
      "description": "Confidential service account for application-owned user administration.",
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [],
      "webOrigins": [],
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
