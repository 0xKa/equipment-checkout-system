{
  "info": {
    "_postman_id": "62cff4fc-9e67-43c2-bdb1-18642a9452b0",
    "name": "Equipment Checkout API",
    "description": "Postman Collection v2.1 for the PostgreSQL-backed Equipment Checkout API. Run make compose-up to build the API, start PostgreSQL and Keycloak, apply migrations, bootstrap the realm, and wait for readiness. Seed data remains optional and explicit. Every /api/v1 request inherits the collection's preconfigured OAuth 2.0 Authorization Code (With PKCE) authentication; /health and /ready remain public. In the collection Authorization tab, select Get New Access Token, sign in through the browser, then select Proceed and Use Token. The public client has no client secret. Keep generated tokens local: do not share, sync, export, commit, or paste them into logs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
