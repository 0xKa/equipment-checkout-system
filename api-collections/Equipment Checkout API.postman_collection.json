    {
      "name": "Users and Authentication",
      "description": "Manages users synchronously in Keycloak and PostgreSQL. User management requires users.manage. Create requests assign exactly one application realm role; profile, role, and activation changes are mirrored. Unknown Keycloak identities are rejected with identity_not_linked.",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman.operator\",\n  \"email\": \"postman.operator@example.test\",\n  \"display_name\": \"Postman Operator\",\n  \"role\": \"employee\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"]
            },
            "description": "Creates one active linked user in Keycloak and PostgreSQL with exactly one approved application realm role."
          },
          "response": []
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"]
            },
            "description": "Returns active and inactive users in ascending ID order."
          },
          "response": []
        },
        {
          "name": "List Active Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?is_active=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"],
              "query": [{ "key": "is_active", "value": "true" }]
            },
            "description": "Filters users by active state. The only accepted values are true and false."
          },
          "response": []
        },
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}"]
            },
            "description": "Returns the user identified by userId."
          },
          "response": []
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"updated.operator\",\n  \"email\": null,\n  \"display_name\": \"Updated Operator\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}"]
            },
            "description": "Synchronizes replacement profile fields while preserving role and is_active. null clears the optional email."
          },
          "response": []
        },
        {
          "name": "Set User Role",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"auditor\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/role",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}", "role"]
            },
            "description": "Replaces only the managed application realm role and the local role column. Obtain a new access token to observe changed capabilities."
          },
          "response": []
        },
        {
          "name": "Set User Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}", "status"]
            },
            "description": "Synchronizes Keycloak enabled state and the local is_active flag without changing profile fields or role."
          },
          "response": []
        },
        {
          "name": "Set Temporary Password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{temporaryPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/temporary-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}", "temporary-password"]
            },
            "description": "Sets a Keycloak-only temporary credential and returns 204. Enter temporaryPassword locally and never export it."
          },
          "response": []
        },
        {
          "name": "Soft-Deprovision User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}"]
            },
            "description": "Disables the Keycloak identity and local user with 204 while preserving checkout, history, and audit references."
          },
          "response": []
        },
        {
          "name": "Get Current Authenticated User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "me"]
            },
            "description": "Verifies the Keycloak access token and resolves its exact pre-linked issuer/subject. Unknown identities are rejected and cannot create local rows."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Checkouts",
      "description": "Employees may check out and return equipment for themselves and may list/get only their own checkout records. Set borrowerUserId to the employee's local user ID. Inventory administrators may act for any active borrower and read all records; auditors have all-record and item-history reads but no mutation access. Workflow attribution always uses the token-derived local actor.",
      "item": [
        {
          "name": "Create Checkout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"borrower_user_id\": {{borrowerUserId}},\n  \"due_at\": \"2030-01-10T17:00:00Z\",\n  \"notes\": \"Presentation checkout\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/items/{{itemId}}/checkouts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items", "{{itemId}}", "checkouts"]
            },
            "description": "Checks out an available item to an active borrower. Employees must set borrowerUserId to their own local ID; administrators may select another active borrower. Returns 201 and atomically writes checkout, item status, history, and audit state."
          },
          "response": []
        },
        {
          "name": "List Checkouts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/checkouts?limit={{checkoutLimit}}&offset={{checkoutOffset}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "checkouts"],
              "query": [
                { "key": "limit", "value": "{{checkoutLimit}}" },
                { "key": "offset", "value": "{{checkoutOffset}}" }
              ]
            },
            "description": "Returns checkout history in descending ID order with bounded pagination metadata. Employees receive only their own borrower-filtered records; administrators and auditors receive all records."
          },
          "response": []
        },
        {
          "name": "Get Checkout",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/checkouts/{{checkoutId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "checkouts", "{{checkoutId}}"]
            },
            "description": "Returns the checkout selected by checkoutId. Employees receive 404 for another borrower's record; administrators and auditors may read any record."
          },
          "response": []
        },
        {
          "name": "List Item Checkouts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items/{{itemId}}/checkouts?limit={{checkoutLimit}}&offset={{checkoutOffset}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items", "{{itemId}}", "checkouts"],
              "query": [
                { "key": "limit", "value": "{{checkoutLimit}}" },
                { "key": "offset", "value": "{{checkoutOffset}}" }
              ]
            },
            "description": "Returns checkout history for an existing item to administrators and auditors. Employees receive 403 because item-wide history can expose other borrowers."
          },
          "response": []
        },
        {
          "name": "Return Checkout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/checkouts/{{checkoutId}}/return",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "checkouts", "{{checkoutId}}", "return"]
            },
            "description": "Returns an active checkout with 200 and atomically restores the item to available. Employees may return only their own active checkout; administrators may return any. The token-derived actor is recorded as the return recipient."
          },
          "response": []
        },
        {
          "name": "Failure - Checkout With Past Due Date",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"borrower_user_id\": {{borrowerUserId}},\n  \"due_at\": \"2020-01-01T00:00:00Z\",\n  \"notes\": \"Expected validation failure\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/items/{{itemId}}/checkouts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items", "{{itemId}}", "checkouts"]
            },
            "description": "Expected failure example: returns 400 invalid_request and leaves checkout, item, history, and audit state unchanged."
          },
          "response": []
        },
        {
          "name": "Failure - Return Checkout Again",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/checkouts/{{checkoutId}}/return",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "checkouts", "{{checkoutId}}", "return"]
            },
            "description": "Expected failure example after a successful return: returns 409 checkout_already_returned without additional history or audit rows."
          },
          "response": []
        }
      ]
    },
